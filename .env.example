# Whiteboard configuration. Copy to `.env` and edit.

# ---- Network ----
PORT=8787
# Public-facing origin. Used for CORS and CSP.
PUBLIC_ORIGIN=http://localhost:8787
# Sub-path mount for reverse-proxy deployments (e.g. /whiteboard).
# Leave as / for root-mount.
BASE_PATH=/

# ---- Logging ----
# trace | debug | info | warn | error
LOG_LEVEL=info

# ----------------------------------------------------------------------
# The sharing-related vars (OWNER_TOKEN, DATA_DIR, MAX_ROOMS,
# MAX_BOARD_BLOB_MB) return when live collaboration returns — sharing is
# deferred from v1 per ADR 0012. See docs/decisions/0012-sharing-deferred.md.
# ----------------------------------------------------------------------
