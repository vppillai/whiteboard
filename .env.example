# Whiteboard configuration. Copy to `.env` and edit.

# ---- Network ----
PORT=8787
# Public-facing origin. Used for CORS, share-link generation, and CSP.
PUBLIC_ORIGIN=http://localhost:8787
# Sub-path mount for reverse-proxy deployments (e.g. /whiteboard).
# Leave as / for root-mount.
BASE_PATH=/

# ---- Auth ----
# Required. Owners who present this token (?token=...) get admin actions
# (rename board, delete, export-all). Anyone with a room URL can still draw.
# Generate with: openssl rand -hex 32
OWNER_TOKEN=replace-me-with-openssl-rand-hex-32

# ---- Storage ----
# Inside the container — this maps to a Docker volume by default.
DATA_DIR=/data

# ---- Limits ----
MAX_ROOMS=500
MAX_BOARD_BLOB_MB=50

# ---- Logging ----
# trace | debug | info | warn | error
LOG_LEVEL=info
